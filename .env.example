# Copy to .env.local and fill in.
#
# Local development: run `npx supabase start`, then `npx supabase status -o env`
# and use API_URL + PUBLISHABLE_KEY below.
#
# Production (Vercel): use your Supabase project's URL and publishable key
# (Project Settings → API keys). The legacy anon key also works via
# NEXT_PUBLIC_SUPABASE_ANON_KEY. NEVER put the service-role/secret key
# anywhere in this app — every query runs as the signed-in user under RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- AI explanations (optional) ---------------------------------------
# Set ONE of these. The app auto-detects whichever is present, so a single
# variable is enough. NEVER prefix these with NEXT_PUBLIC_ — that would ship
# the key to the browser.
#
#   GROQ_API_KEY=        console.groq.com/keys — free, fast, llama-3.3-70b
#   OPENROUTER_API_KEY=  openrouter.ai/keys — free ":free" models, no card
#   GEMINI_API_KEY=      aistudio.google.com/apikey — best Indian-context recall
#   MISTRAL_API_KEY=     console.mistral.ai
#   CEREBRAS_API_KEY=    cloud.cerebras.ai
#   TOGETHER_API_KEY=    api.together.xyz
#
# Optional overrides:
#   AI_PROVIDER=groq     force a provider when several keys are set
#   AI_MODEL=            override the default model for that provider
#
# Any other OpenAI-compatible endpoint:
#   AI_PROVIDER=custom
#   AI_API_KEY=
#   AI_BASE_URL=https://example/v1
#   AI_MODEL=model-name
