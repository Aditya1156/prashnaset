# Copy to .env.local and fill in.
#
# Local development: run `npx supabase start`, then `npx supabase status -o env`
# and use API_URL + PUBLISHABLE_KEY below.
#
# Production (Vercel): use your Supabase project's URL and publishable key
# (Project Settings → API keys). The legacy anon key also works via
# NEXT_PUBLIC_SUPABASE_ANON_KEY. NEVER put the service-role/secret key
# anywhere in this app — every query runs as the signed-in user under RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
